# Copy to .env and replace every value. Never commit .env.
DATABASE_NAME=orderflow
DATABASE_USERNAME=orderflow
DATABASE_PASSWORD=change-me
RABBITMQ_USERNAME=orderflow
RABBITMQ_PASSWORD=change-me
# At least 32 bytes. Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
# Optional: bootstrap an admin account on first start
ADMIN_EMAIL=admin@orderflow.local
ADMIN_PASSWORD=change-me-admin
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Include classpath:db/seed to load the demo catalogue
FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/seed
